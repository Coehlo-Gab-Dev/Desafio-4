generator client {
  provider = "prisma-client-js"
  previewFeatures = ["mongodb", "fullTextSearch"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model EstabelecimentoSaude {
  id               String     @id @default(auto()) @map("_id") @db.ObjectId
  idCnes           String     @unique
  nome             String
  tipo             TipoEstabelecimentoSaude
  localizacao      Localizacao
  contato          Contato
  servicos         Servico[]
  leitos           Leitos?
  acessibilidade   Acessibilidade?
  horarioFuncionamento String?
  fonteDados       FonteDados
  dataAtualizacao  DateTime   @default(now())
  

  @@index([tipo])
  @@index([localizacao.municipio])
  @@index([localizacao.uf])
  @@fulltext([nome])
}

model PontoCultural {
  id               String     @id @default(auto()) @map("_id") @db.ObjectId
  nome             String
  tipo             TipoPontoCultural
  descricao        String?
  localizacao      Localizacao
  contato          Contato
  acessibilidade   Acessibilidade
  horarioFuncionamento String?
  imagens          String[]
  fonteDados       FonteDados
  dataAtualizacao  DateTime   @default(now())
  dataCriacao      DateTime   @default(now())

  @@index([nome])
  @@index([tipo])
  @@index([localizacao.municipio])
  @@fulltext([nome, descricao])
}

model Escola {
  id               String     @id @default(auto()) @map("_id") @db.ObjectId
  codigoInep       String     @unique
  nome             String
  nivel            NivelEscolar
  endereco         Endereco
  contato          Contato
  estrutura        EstruturaEscola[]
  matriculas       Int
  fonteDados       FonteDados
  dataAtualizacao  DateTime   @default(now())
  dataCriacao      DateTime   @default(now())


  @@index([nome])
  @@index([nivel])
  @@index([endereco.municipio])
  @@fulltext([nome, endereco.bairro])
}

model ServicoSocial {
  id               String     @id @default(auto()) @map("_id") @db.ObjectId
  nome             String
  tipo             TipoServicoSocial
  descricao        String
  publicoAlvo      String[]
  requisitos       String[]
  localizacao      Localizacao
  contato          Contato
  horarioAtendimento String
  fonteDados       FonteDados
  dataAtualizacao  DateTime   @default(now())
  dataCriacao      DateTime   @default(now())

  @@index([nome])
  @@index([tipo])
  @@index([localizacao.municipio])
  @@fulltext([nome, descricao, publicoAlvo])
}

// Tipos embutidos (embedded documents)
type Localizacao {
  logradouro    String
  numero        String?
  complemento   String?
  bairro        String
  municipio     String
  uf            String
  cep           String
  coordenadas   Json?  // { type: "Point", coordinates: [long, lat] }
}

type Contato {
  telefone      String?
  email         String?
  site          String?
  redesSociais  String[]
}

type Acessibilidade {
  cadeirante    Boolean @default(false)
  deficienciaVisual Boolean @default(false)
  deficienciaAuditiva Boolean @default(false)
  linguasSinais String[] // Ex: ["Libras"]
}

type Servico {
  nome          String
  disponivel    Boolean @default(true)
  descricao     String?
}

type Leitos {
  total         Int
  uti           Int
  pediatricos   Int
  covid         Int
}

type Endereco {
  logradouro    String
  numero        String?
  complemento   String?
  bairro        String
  municipio     String
  uf            String
  cep           String
}

type EstruturaEscola {
  item          String  // Ex: "Quadra", "Laboratório de Informática"
  quantidade    Int
  disponivel    Boolean @default(true)
}

// Enums para tipos pré-definidos
enum TipoEstabelecimentoSaude {
  HOSPITAL
  UPA
  UBS
  PS
  CENTRO_SAUDE
  FARMACIA_POPULAR
  LABORATORIO
  POLICLINICA
}

enum TipoPontoCultural {
  MUSEU
  BIBLIOTECA
  TEATRO
  CINEMA
  CENTRO_CULTURAL
  MONUMENTO
  BIBLIOTECA_PUBLICA
}

enum NivelEscolar {
  INFANTIL
  FUNDAMENTAL
  MEDIO
  TECNICO
  SUPERIOR
}

enum TipoServicoSocial {
  CRAS
  CREAS
  BOLSA_FAMILIA
  AUXILIO_BRASIL
  ACESSO_A_TRABALHO
  ACESSO_A_MORADIA
}

enum FonteDados {
  CNES
  API_HOSPITAIS
  API_UBS
  INEP
  SNIIC
  MDS
  MANUAL
}