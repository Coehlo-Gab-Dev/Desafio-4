{
  "name": "api-servicos-publicos",
  "version": "1.0.0",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "clean": "rmdir /s /q node_modules && del package-lock.json",
    "reset": "npm run clean && npm install",
    "seed": "node prisma/seeds/seed.js",
    "dev": "nodemon src/app.js",
    "start": "node src/app.js",
    "start:dev": "NODE_ENV=development nodemon src/app.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:deploy": "prisma migrate deploy",
    "test": "jest --detectOpenHandles",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .js --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Coehlo-Gab-Dev/Desafio-4.git"
  },
  "author": "Seu Nome <seu.email@example.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Coehlo-Gab-Dev/Desafio-4/issues"
  },
  "homepage": "https://github.com/Coehlo-Gab-Dev/Desafio-4#readme",
  "keywords": [
    "api",
    "servicos-publicos",
    "governo",
    "nodejs"
  ],
  "description": "API de integração com serviços públicos governamentais",
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "api-servicos-publicos": "file:",
    "axios": "^1.9.0",
    "axios-retry": "^4.5.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^6.11.2",
    "express-validator": "^6.15.0",
    "fs": "^0.0.1-security",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.16.0",
    "mongoose": "^8.15.0",
    "morgan": "^1.10.0",
    "redis": "^5.0.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^4.6.3",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prisma": "^6.8.2",
    "supertest": "^6.3.4"
  },
  "prisma": {
    "schema": "./prisma/schema.prisma",
    "seed": "./prisma/seeds/seed.js"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/tests/"
    ]
  },
  "engines": {
    "node": "14.x"
  }
}
